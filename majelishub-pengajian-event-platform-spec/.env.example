# MajelisHub - environment reference (Phase 0)
# Full documentation: DEPLOYMENT.md §3. Every variable here is validated by the config module at boot;
# a missing required value must fail the boot, never a request.
# SECURITY: secrets (marked here) are provided by the secret store in deployed environments.
# No production value belongs in this file, in git, or in a test.

NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://majelishub_app:change-me@localhost:5432/majelishub
DATABASE_MIGRATION_URL=postgres://majelishub_owner:change-me@localhost:5432/majelishub
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Auth / sessions
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-random            # SECRET
RATE_LIMIT_STORE=postgres                                        # in-memory is forbidden in production
AUTH_SESSION_IDLE_SECONDS=28800                                  # 8 h idle timeout for organizer/admin surfaces (SECURITY.md §2)
TRUSTED_PROXY_HOPS=1

# Storage (S3-compatible, private buckets)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio                                            # SECRET
S3_SECRET_ACCESS_KEY=minio-secret                                 # SECRET
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS_PARTIAL=majelishub-partial
S3_BUCKET_AUDIO_MASTER=majelishub-master
S3_BUCKET_AUDIO_DERIVED=majelishub-derived
S3_BUCKET_EXPORTS=majelishub-exports
S3_SIGNED_URL_TTL_SECONDS=300
S3_SERVER_SIDE_ENCRYPTION=AES256

# Jobs
JOBS_ENABLED=false
JOB_CONCURRENCY_ASSEMBLY=1
JOB_CONCURRENCY_MEDIA=1
JOB_CONCURRENCY_TRANSCRIPTION=1
JOB_CONCURRENCY_NOTIFY=2
JOB_CONCURRENCY_RETENTION=1
JOB_RETRY_LIMIT_DEFAULT=3
JOB_DEAD_LETTER_AFTER_DAYS=14
JOB_PURGE_AFTER_DAYS=30

# Media
MEDIA_WORKER_ENABLED=false
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_MAX_SESSION_BYTES=524288000
MEDIA_NORMALIZE_TARGET_LUFS=-16
MEDIA_TMP_DIR=/tmp/majelishub-media

# Transcription (egress OFF by default - see T-TRANSCRIPT-005 and PRIVACY.md §5)
TRANSCRIPTION_PROVIDER=DISABLED
TRANSCRIPTION_EGRESS_ENABLED=false
TRANSCRIPTION_PROVIDER_URL=
TRANSCRIPTION_PROVIDER_KEY=                                       # SECRET
TRANSCRIPTION_REVIEW_SLA_DAYS=7
TRANSCRIPTION_MAX_AUDIO_MINUTES=180

# Notifications
EMAIL_PROVIDER=disabled
EMAIL_FROM=kajian@example.test
EMAIL_API_KEY=                                                    # SECRET
NOTIFICATION_QUIET_HOURS=21:00-06:00
NOTIFICATION_CHANNELS_ENABLED=in_app,email

# Retention (dry-run outside production; enabled in VS-13)
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_REGISTRATION_DAYS=548
RETENTION_ATTENDANCE_DAYS=730
RETENTION_TOKEN_DAYS=30
RETENTION_SESSION_DAYS=30
RETENTION_AUTH_RATE_LIMIT_DAYS=7
RETENTION_AUDIO_MASTER_DAYS=730
RETENTION_ASR_DERIVATIVE_DAYS=30
RETENTION_FEEDBACK_DAYS=365
RETENTION_AUDIT_DAYS=2555
RETENTION_EXPORT_DAYS=7
RETENTION_NOTIFICATION_DAYS=180
RETENTION_BATCH_SIZE=500

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=majelishub
OTEL_SAMPLING_RATIO=0.1
METRICS_ENABLED=true

# Operations
MAINTENANCE_MODE=false
SECRET_SCAN_ENABLED=true
