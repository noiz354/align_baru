# HomeOps environment — copy to .env.local for development.
# Values shown are placeholders. Never commit real secrets (SECURITY.md §10).

# --- required ---
DATABASE_URL=postgres://homeops:homeops@localhost:5432/homeops
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-32-bytes-of-random
CRON_SECRET=replace-with-random

# --- optional: web push (ADR-009, ADR-014) ---
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:owner@example.com

# --- optional: observability (ADR-015; absent = no-op exporter) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- optional: email channel ADR-019 (absent = shareable invite links) ---
# EMAIL_PROVIDER_URL=
# EMAIL_PROVIDER_TOKEN=
# EMAIL_FROM=homeops@example.com

# --- optional: photo storage (proposed ADR-017; VS-11) ---
# ATTACHMENT_STORAGE_DRIVER=local
# ATTACHMENT_STORAGE_ROOT=/var/lib/homeops/attachments
