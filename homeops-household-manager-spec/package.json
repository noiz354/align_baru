{
  "name": "homeops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HomeOps — household manager (chores, rooms, trash, resources, maintenance, issues, alerts).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:contrast": "node scripts/check-contrast.mjs",
    "traceability": "node scripts/build-traceability.mjs",
    "verify": "npm run verify:docs && npm run verify:contrast && npm run typecheck && npm run lint && npm run test:unit && npm run test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "scheduler:tick": "tsx scripts/tick.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "verify:bundle": "node scripts/check-bundle.mjs",
    "verify:all": "npm run verify:docs && npm run verify:contrast && npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run build && npm run verify:bundle"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
