{
  "name": "strangerlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StrangerLink random stranger chat — WebRTC, safety, moderation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:realtime": "vitest run --project realtime",
    "test:watch": "vitest --project unit",
    "realtime": "tsx src/server/realtime/server.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "tsx": "^4.19.1",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
