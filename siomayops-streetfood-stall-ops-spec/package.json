{
  "name": "siomayops",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --browser.enabled",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "check:stubs": "node tools/check-stubs.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "census": "node tools/census.mjs"
  },
  "dependencies": {
    "next": "15.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1",
    "drizzle-orm": "0.44.3",
    "pg": "8.13.0",
    "pino": "9.6.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.57.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/pg": "8.11.10",
    "eslint": "9.20.0",
    "tailwindcss": "4.0.0",
    "drizzle-kit": "0.31.4",
    "vitest": "3.1.1",
    "playwright": "1.50.0",
    "@playwright/test": "1.50.0",
    "@types/react-dom": "19.0.3"
  },
  "optionalDependencies": {}
